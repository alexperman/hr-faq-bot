# Database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/alterzahen

# JWT (generate with: openssl rand -base64 32)
SECRET_KEY=change-me-use-openssl-rand-base64-32

# CORS (comma-separated origins; use * for all in dev)
ALLOWED_ORIGINS=*

# Groq AI (free tier at console.groq.com)
GROQ_API_KEY=

# PayPal (sandbox or live)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# App
APP_URL=https://your-app.onrender.com
PRICE_ID=P-XXXXXXXXXXXXXXXX

# Optional per-plan PayPal IDs (if unset, falls back to PRICE_ID)
PRICE_ID_STARTER=
PRICE_ID_GROWTH=
PRICE_ID_ENTERPRISE=
